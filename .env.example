# EcoRoute configuration — copy to .env. With no API keys, EcoRoute runs in simulate mode.

# --- Provider keys (add any you have) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# --- Local models via Ollama (auto-detected) ---
OLLAMA_HOST=http://localhost:11434

# --- Routing ---
ECOROUTE_MODE=auto              # auto | live | simulate
ECOROUTE_POLICY=balanced        # eco | balanced | quality | cost
ECOROUTE_BASELINE_MODEL=openai-gpt-5
ECOROUTE_LOCAL_REGION=india     # grid region of your own machine (see ecoroute/data/grid.yaml)

# --- Cost & efficiency management ---
ECOROUTE_MONTHLY_BUDGET_USD=0          # 0 = no budget
ECOROUTE_MONTHLY_ENERGY_BUDGET_WH=0    # 0 = no budget
ECOROUTE_CACHE=true
ECOROUTE_CACHE_TTL_HOURS=24
ECOROUTE_STORE_PROMPTS=true

# --- Live grid carbon intensity (optional) ---
ELECTRICITYMAPS_API_KEY=

ECOROUTE_DB=ecoroute.db

# --- Access control (optional) ---
# ECOROUTE_API_KEYS=sk-eco-search:search,sk-eco-support:support   # key:team pairs; enables auth
# ECOROUTE_ADMIN_KEY=sk-eco-admin                                 # reset, budgets, demo seeding

# --- Quality safeguards (optional) ---
# ECOROUTE_CASCADE=true            # re-ask a stronger model when an answer clearly fails
# ECOROUTE_SHADOW_RATE=0.05        # grade 5% of live answers against the baseline (extra calls)
# ECOROUTE_JUDGE_MODEL=openai-gpt-5-mini
# ECOROUTE_CONCISE=true            # ask for brief answers and cap output tokens
# CRON_SECRET=...                  # lets a scheduler (e.g. Vercel Cron) call /v1/batch-run
