# EcoRoute configuration — copy to .env. With no API keys, EcoRoute runs in simulate mode.

# --- Provider keys (add any you have) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# --- Local models via Ollama (auto-detected) ---
OLLAMA_HOST=http://localhost:11434

# --- Routing ---
ECOROUTE_MODE=auto              # auto | live | simulate
ECOROUTE_POLICY=balanced        # eco | balanced | quality | cost
ECOROUTE_BASELINE_MODEL=openai-gpt-5
ECOROUTE_LOCAL_REGION=india     # grid region of your own machine (see ecoroute/data/grid.yaml)

# --- Cost & efficiency management ---
ECOROUTE_MONTHLY_BUDGET_USD=0          # 0 = no budget
ECOROUTE_MONTHLY_ENERGY_BUDGET_WH=0    # 0 = no budget
ECOROUTE_CACHE=true
ECOROUTE_CACHE_TTL_HOURS=24
ECOROUTE_STORE_PROMPTS=true

# --- Live grid carbon intensity (optional) ---
ELECTRICITYMAPS_API_KEY=

ECOROUTE_DB=ecoroute.db
